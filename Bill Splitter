try:
    subtotal = float(input("Enter total bill: "))
    people = int(input("Number of people: "))
    tax_percent = float(input("Tax percentage: "))
    tip_percent = float(input("Tip percentage: "))

    tax_amount = subtotal * tax_percent / 100 #calculate tax amount
    after_tax = subtotal + tax_amount #total after adding tax
    tip_amount = after_tax * tip_percent / 100 #calculate tip based on after tax amount
    total_bill = after_tax + tip_amount #final total bill
    per_person = total_bill / people #amount each person payss

    print("\n=== BILL BREAKDOWN ===")
    print(f"Subtotal: Rs.{subtotal:.2f}")
    print(f"Tax: Rs.{tax_amount:.2f}")
    print(f"After tax: Rs.{after_tax:.2f}")
    print(f"Tip: Rs.{tip_amount:.2f}")
    print(f"Total: Rs.{total_bill:.2f}")
    print(f"Per person: Rs.{per_person:.2f}")

except ValueError:
    print("Invalid input.")