try:
    n = int(input("Enter number: ")) 

    fact = 1 
    steps = ""

    for i in range(n, 0, -1): # Loop from n down to 1
        fact *= i # Multiply to get factorial
        steps += str(i) + " x " # Build the steps string

    print(f"{n}! = {steps[:-3]} = {fact}") # Remove the last " x " and display result
except ValueError:
    print("Invalid input")