marks = []

try:
    for i in range(1, 6): # Loop to get marks for 5 subjects
        mark = float(input(f"Enter subject {i} marks: "))
        marks.append(mark) # Append marks to the list

    total = sum(marks) # Calculate total marks
    percentage = total / 5 # Calculate percentage

    if all(mark >= 40 for mark in marks): # Check if all marks are 40 or above
        result = "Pass"
    else:
        result = "Fail"

    if percentage >= 90:
        grade = "A+"
    elif percentage >= 80:
        grade = "A"
    elif percentage >= 70:
        grade = "B"
    elif percentage >= 60:
        grade = "C"
    elif percentage >= 50:
        grade = "D"
    else:
        grade = "F"

    print("\nTotal:", total)
    print("Percentage:", percentage)
    print("Grade:", grade)
    print("Result:", result)

except ValueError:
    print("Invalid input.")