try:
    year = int(input("Enter a year: "))

    print("\n=== LEAP YEAR ANALYSIS ===")

    # Rule 1 - Divisible by 400 - Always leap year
    if year % 400 == 0:
        print(f"{year} is a Leap Year ")
        print("Reason: Divisible by 400")

    # Rule 2 - Divisible by 100 - NOT leap year
    elif year % 100 == 0:
        print(f"{year} is NOT a Leap Year ")
        print("Reason: Divisible by 100 but not by 400.")

    # Rule 3 - Divisible by 4 - Leap year
    elif year % 4 == 0:
        print(f"{year} is a Leap Year ")
        print("Reason: Divisible by 4 but not by 100")

    # Otherwise - Not leap year
    else:
        print(f"{year} is NOT a Leap Year ")
        print("Reason: Not divisible by 4")

except ValueError:
    print("Invalid input. Please enter a valid year")