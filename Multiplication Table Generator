try:
    number = int(input("Enter number: "))
    range_end = int(input("Enter range: "))

    # Validate inputs
    if range_end <= 0:
        print("Range must be positive")

    else:
        print(f"\nMultiplication Table of {number}")

        # Loop from 1 to range
        for i in range(1, range_end + 1): 
            result = number * i # Calculate multiplication result
            print(f"{number} x {i} = {result}") # Display the result
        
        # Full multiplication table from 1 to 10
        print("\n=== FULL MULTIPLICATION TABLE ===\n")

        for i in range(1, 11):          # Rows
             for j in range(1, 11):      # Columns
                 print(f"{i*j:4}", end="")  # Width formatting for alignment
             print()

except ValueError:
    print("Invalid input. Please enter numbers only")