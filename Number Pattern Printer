try:
    print("\nSelect Pattern")
    print("1. Pattern 1")
    print("2. Pattern 2")
    print("3. Pattern 3")
    print("4. Pattern 4")

    choice = int(input("Enter choice: "))
    height = int(input("Enter height: "))

    print("\n--- OUTPUT ---")

    #  Pattern 1
    if choice == 1:
        for i in range(1, height + 1):
            for j in range(1, i + 1):
                print(j, end=" ")
            print()

    #  Pattern 2 
    elif choice == 2:
        for i in range(1, height + 1):
            for j in range(i):
                print(i, end=" ")
            print()

    #  Pattern 3 
    elif choice == 3:
        start = 5 

        for i in range(start, 0, -1):
            for j in range(i, 0, -1):
                print(j, end=" ")
            print()

    #  Pattern 4 
    elif choice == 4:
        for i in range(1, height + 1):

            # Ascending
            for j in range(1, i + 1):
                print(j, end="")

            # Descending
            for j in range(i - 1, 0, -1):
                print(j, end="")

            print()

    else:
        print("Invalid choice")

except ValueError:
    print("Invalid input")