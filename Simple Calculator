try:
    num1 = float(input("Enter first number: ")) 
    num2 = float(input("Enter second number: "))

    print("\nResults:")
    print(f"{num1} + {num2} = {num1 + num2}") #prints the sum of num1 and num2
    print(f"{num1} - {num2} = {num1 - num2}") #prints the difference of num1 and num2
    print(f"{num1} * {num2} = {num1 * num2}") #prints the product of num1 and num2
    print(f"{num1} / {num2} = {round(num1 / num2, 2)}") #prints the quotient of num1 and num2, rounded to 2 decimal places
    print(f"{num1} % {num2} = {num1 % num2}") #prints the modulus of num1 and num2
    print(f"{num1} ^ {num2} = {num1 ** num2}")  #prints num1 raised to the power of num2

except ValueError:
    print("Invalid input.")