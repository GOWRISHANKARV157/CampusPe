try:
    
    numbers = [] # List to store user-entered numbers

    count = int(input("How many numbers? ")) # Get the count of numbers to be entered

    for i in range(count):
         num = float(input(f"Enter number {i+1}: ")) # Convert input to float for decimal support
         numbers.append(num) # Add the number to the list

    # Calculate and display results
    print("Sum:", sum(numbers)) #display the sum of the numbers
    print("Average:", sum(numbers) / len(numbers)) #display the average of the numbers
    print("Max:", max(numbers)) #display the maximum number from the list
    print("Min:", min(numbers)) #display the minimum number from the list
    
except ValueError:
    print("Invalid input. Please enter numbers only")