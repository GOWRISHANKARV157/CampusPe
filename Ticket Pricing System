age = int(input("Enter age: "))
day = input("Enter day: ").lower()
tickets = int(input("Number of tickets: "))

if age < 3:
    price = 0
elif age <= 12:
    price = 150
elif age <= 59:
    price = 300
else:
    price = 200

total = price * tickets #total cost before discount

if day in ["friday", "saturday", "sunday"]: #weekend discount
    discount = total * 0.2
else: #weekday discount
    discount = 0 

print("Total:", total - discount)